  "safeStates": [
    "initial loading",
    "populated coverage",
    "mixed Senior Citizen and PWD coverage",
    "authoritative no coverage",
    "empty result",
    "permission denied",
    "scope denied",
    "source unavailable",
    "timeout",
    "malformed response",
    "malformed authoritative record",
    "unsupported authoritative classification"
  ],
  "prohibitedBrowserHeaders": [
    "Authorization",
    "X-ExitPass-Permissions",
    "X-Management-Platform-Permissions",
    "X-ExitPass-Service-Identity-Id",
    "X-ExitPass-User-Id"
  ],
  "testScenarios": [
    "site-group-covered",
    "site-covered",
    "mixed",
    "senior-citizen",
    "pwd",
    "no-coverage",
    "empty",
    "scope-denied",
    "scope-not-found",
    "source-unavailable",
    "timeout",
    "malformed-response",
    "malformed-authoritative",
    "unexpected-failure",
    "ambiguous-scope",
    "api-boundary"
  ]
}
