{
  "contractName": "ExitPass Management Platform Statutory Policy Coverage Read-Only UI",
  "version": "1.0",
  "route": "/management-platform/statutory-policy-coverage",
  "navigationLabel": "Statutory Policy Coverage",
  "requiredPermission": "statutory-discount-policy.view",
  "backendReadEndpoint": {
    "method": "GET",
    "path": "/v1/ops/management-platform/statutory-discounts/policy-coverage",
    "namedPolicy": "ManagementPlatformStatutoryDiscountPolicyCoverageRead",
    "source": "Central PMS I-004"
  },
  "readOnlyPosture": {
    "policyMutation": false,
    "statutoryDecisionMutation": false,
    "payableBasisMutation": false,
    "paymentMutation": false,
    "fiscalMutation": false,
    "siteScopeMutation": false,
    "browserStorageWrites": false
  },
  "queryFields": [
    "scopeType",
    "scopeId",
    "entitlementType",
    "includeInactive"
  ],
  "visibleFields": [
    "requestedScopeType",
    "requestedScopeReference",
    "resolvedScopeType",
    "resolvedScopeReference",
    "scopeDisplayName",
    "correlationId",
    "evaluationTimestamp",
    "coverageRows.siteReference",
    "coverageRows.siteDisplayName",
    "coverageRows.entitlementType",
    "coverageRows.coverageClassification",
    "coverageRows.policyStatusClassification",
    "coverageRows.authoritativeCoverageAvailable",
    "coverageRows.effectiveFrom",
    "coverageRows.effectiveTo",
    "coverageRows.policyReference",
    "coverageRows.ordinanceOrLegalAuthorityReference",
    "coverageRows.jurisdictionOrLocalityReference",
    "coverageRows.policyVersionOrRevisionReference",
    "coverageRows.lastAuthoritativeUpdateTimestamp",
    "coverageRows.dataQualityClassification",
    "coverageRows.reasonClassification",
    "coverageRows.sourceClassification"
  ],
  "safeClassifications": [
    "ACTIVE_COVERED",
    "FUTURE_EFFECTIVE",
    "EXPIRED",
    "INACTIVE",
    "INCOMPLETE_CONFIGURATION",
    "NO_APPLICABLE_ORDINANCE",
    "NO_APPLICABLE_POLICY",
    "ENTITLEMENT_NOT_COVERED",
    "AUTHORITATIVE_SOURCE_UNAVAILABLE",
    "MALFORMED_AUTHORITATIVE_RECORD",
    "SCOPE_DENIED",
    "SCOPE_NOT_FOUND",
    "INVALID_SCOPE_TYPE",
    "INVALID_SCOPE_REFERENCE",
    "EMPTY_GOVERNED_SCOPE",
    "POLICY_SOURCE_UNAVAILABLE",
    "ORDINANCE_SOURCE_UNAVAILABLE",
    "TRANSIENT_DEPENDENCY_FAILURE",
    "UNEXPECTED_INTERNAL_FAILURE"
