# ExitPass Management Platform browser-safe configuration
# Copy to a local .env file when needed. Do not commit .env files.

VITE_MANAGEMENT_PLATFORM_BASE_PATH=/management-platform
VITE_MANAGEMENT_PLATFORM_CENTRAL_PMS_API_BASE_PATH=/v1/management-platform
VITE_MANAGEMENT_PLATFORM_ENVIRONMENT_NAME=Local development
VITE_MANAGEMENT_PLATFORM_API_PROXY_TARGET=http://127.0.0.1:56065

# Explicit local-development scenario fixtures only. Production runtime ignores these values and uses I-020 current-session readback.
VITE_MANAGEMENT_PLATFORM_SUBJECT_REF=local-management-platform-user
VITE_MANAGEMENT_PLATFORM_DISPLAY_NAME=Management Platform User
VITE_MANAGEMENT_PLATFORM_PERMISSIONS=management-platform.overview.read,sales-invoice-profile.read

MANAGEMENT_PLATFORM_DEV_PORT=5178
MANAGEMENT_PLATFORM_E2E_PORT=5179
MANAGEMENT_PLATFORM_E2E_PRODUCTION_PORT=5180
